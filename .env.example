# OmniTrace environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.

PORT=3001

# MongoDB — local dev default
MONGODB_URI=mongodb://localhost:27017
DB_NAME=omnidb

# PostgreSQL — local dev default
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example (default): postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/omnidb
# Example (Homebrew port 5433 / trust auth): postgresql://postgres@localhost:5433/omnidb
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/omnidb

