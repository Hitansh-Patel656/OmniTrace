{
    "dataset_notes": {
        "purpose": "Synthetic multi-channel event dataset for OmniTrace development, identity-resolution testing, and demo purposes.",
        "ground_truth_customer_id": "Present on every event ONLY for evaluating identity-resolution accuracy during development. It must NOT be used as an input to the resolution algorithm itself — the algorithm should re-derive it from raw_identifiers alone. Compare its output against this field to measure accuracy.",
        "churn_rule_reference": "ADR-005: a customer is labeled churned if they have an unresolved escalation followed by 30+ days of no further activity across any channel.",
        "scenarios": {
            "cust_001": "Alice — clean successful journey across web and app, no issues.",
            "cust_002": "Bob — cart drop-off on web, no further activity (drop-off, not churn — no escalation involved).",
            "cust_003": "Carol — call-center escalation that gets resolved (escalation, not churn).",
            "cust_004": "Dave — repeat contact across call-center and web for the same unresolved issue (repeat-contact pattern).",
            "cust_005": "Eve — call-center escalation left unresolved, followed by 30+ days of silence (churn = true per ADR-005).",
            "cust_006": "Frank — full cross-channel deterministic identity resolution test: anonymous web session -> logs in (links cookie+email+loyalty_id) -> app login (links device_id) -> call center (links phone via loyalty_id) -> in-person visit (loyalty_id only).",
            "cust_007": "Grace — probabilistic identity resolution test: two anonymous web sessions with different cookie IDs but the same IP address and close time proximity, no deterministic identifier ever appears."
        }
    },
